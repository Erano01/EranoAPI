<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.erano01</groupId>
        <artifactId>EranoAPI</artifactId>
        <version>1.0.0-alpha.3</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>EranoAPI-Paper-NMS</artifactId>
    <packaging>pom</packaging>

    <!-- Internal: the version modules are shaded into Spigot/Dist and never published on their own. -->
    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.source.skip>true</maven.source.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <gpg.skip>true</gpg.skip>
    </properties>

    <!-- One module per vX_Y_RZ revision, the Paper twin of Spigot/NMS/<revision>: same version range,
         compiled against the Paper server of the Minecraft version build-spigot-jars.sh builds.
         Paper server jars (io.papermc.paper:paper-server:<mc>-local) come from scripts/build-paper-jars.sh.
         Paper has no v1_8_R1, v1_8_R2 and v1_9_R1. -->
    <modules>
        <module>V26_3</module>
        <module>V26_2</module>
        <module>V26_1</module>
        <module>V1_21_R7</module>
        <module>V1_21_R6</module>
        <module>V1_21_R5</module>
        <module>V1_21_R4</module>
        <module>V1_21_R3</module>
        <module>V1_21_R2</module>
        <module>V1_21_R1</module>
        <module>V1_20_R4</module>
        <module>V1_20_R3</module>
        <module>V1_20_R2</module>
        <module>V1_20_R1</module>
        <module>V1_19_R3</module>
        <module>V1_19_R2</module>
        <module>V1_19_R1</module>
        <module>V1_18_R2</module>
        <module>V1_18_R1</module>
        <module>V1_17_R1</module>
        <module>V1_16_R3</module>
        <module>V1_16_R2</module>
        <module>V1_16_R1</module>
        <module>V1_15_R1</module>
        <module>V1_14_R1</module>
        <module>V1_13_R2</module>
        <module>V1_13_R1</module>
        <module>V1_12_R1</module>
        <module>V1_11_R1</module>
        <module>V1_10_R1</module>
        <module>V1_9_R2</module>
        <module>V1_8_R3</module>
    </modules>

    <dependencies>
        <dependency>
            <groupId>io.github.erano01</groupId>
            <artifactId>EranoAPI-Spigot</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <!-- paper-api and Paper's own libraries, dependencies of the paper-server POMs of 1.18+ -->
    <repositories>
        <repository>
            <id>papermc-repo</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

</project>
