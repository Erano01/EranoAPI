<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>io.github.erano01</groupId>
		<artifactId>EranoAPI</artifactId>
		<version>1.0.0-alpha.3-SNAPSHOT</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>

	<!-- What plugin developers compile against: compileOnly / provided, the EranoAPI plugin
	     (spigot/dist) provides it at runtime. -->
	<artifactId>EranoAPI-Spigot</artifactId>
	<name>EranoAPI-Spigot</name>
	<description>Bukkit / Spigot API of EranoAPI; the EranoAPI plugin provides it at runtime.</description>
	<packaging>jar</packaging>

	<dependencies>
		<dependency>
			<groupId>io.github.erano01</groupId>
			<artifactId>EranoAPI-Common</artifactId>
			<version>${project.version}</version>
		</dependency>
	</dependencies>

	<profiles>
		<!-- spigot-api only exists as -SNAPSHOT, and Maven Central rejects released POMs that depend on
		     snapshots. Declared in a property-activated profile, which is always active (the property is
		     never set) so compiling works, while flatten-maven-plugin leaves such dependencies out of the
		     published POM (embedBuildProfileDependencies=false). It's provided anyway: plugin developers
		     bring their own spigot-api and the server supplies it at runtime. -->
		<profile>
			<id>spigot-api</id>
			<activation>
				<property>
					<name>!eranoapi.withoutSpigotApi</name>
				</property>
			</activation>
			<dependencies>
				<!-- latest spigot-api needed -->
				<dependency>
					<groupId>org.spigotmc</groupId>
					<artifactId>spigot-api</artifactId>
					<version>1.21.6-R0.1-SNAPSHOT</version>
					<scope>provided</scope>
				</dependency>
			</dependencies>
		</profile>
	</profiles>

	<build>
		<!-- plugin.yml takes its version from the POM (scripts/set-version.sh). -->
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
				<includes>
					<include>plugin.yml</include>
				</includes>
			</resource>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>false</filtering>
				<excludes>
					<exclude>plugin.yml</exclude>
				</excludes>
			</resource>
		</resources>
	</build>

</project>
